# ─────────────────────────────────────────────────────────────────────────────
# CompanyOS — Environment Configuration Template
#
# Copy this file to .env and fill in the values.
# NEVER commit the .env file to Git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=generate_a_strong_32_char_secret_key_here

# ── Gmail SMTP ────────────────────────────────────────────────────────────────
# MAIL_USERNAME must be a full Gmail address: yourname@gmail.com
# MAIL_PASSWORD must be a Google App Password (16 chars, no spaces).
# Steps to generate an App Password:
#   1. Enable 2-Step Verification on the Gmail account.
#   2. Google Account → Security → App Passwords.
#   3. Select "Mail" and generate — copy the 16-character password.
MAIL_USERNAME=youraddress@gmail.com
MAIL_PASSWORD=your_16_char_app_password_here

# ── Google OAuth 2.0 ──────────────────────────────────────────────────────────
# GOOGLE_CLIENT_ID — the OAuth 2.0 client ID from Google Cloud Console.
#   See: https://console.cloud.google.com/apis/credentials
#   Create credentials → OAuth 2.0 Client ID → Web application
#   Authorized redirect URI: http://localhost:8080/api/auth/google/callback
# GOOGLE_CLIENT_SECRET — the client secret from Google Cloud Console.
#   Keep this SECRET — never expose it in the frontend or Git.
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ── Google OAuth Redirect URI ─────────────────────────────────────────────────
# Optional. Defaults to http://localhost:8080/api/auth/google/callback
# GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/google/callback
